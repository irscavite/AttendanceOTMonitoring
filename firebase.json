{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "index.html",
      "styles*.css",
      "app*.js",
      "firebase-backend.js",
      "firebase-config.js",
      "firebase-messaging-sw.js",
      "push-notifications.js",
      "manifest.webmanifest",
      "icon-192.png",
      "icon-512.png",
      "PUSH-NOTIFICATION-SETUP.txt"
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "database.rules.json",
      "cloud-functions.js",
      "package.json",
      "package-lock.json",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
