{
  "rules": {
    "system": {
      "bootstrapComplete": {
        ".read": true,
        ".write": "auth != null && root.child('accounts').child(auth.uid).child('role').val() === 'IT' && root.child('accounts').child(auth.uid).child('active').val() === true && newData.val() === true"
      }
    },
    "accounts": {
      ".read": "auth != null && root.child('accounts').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && root.child('accounts').child(auth.uid).child('role').val() === 'IT' && root.child('accounts').child(auth.uid).child('active').val() === true) || (auth != null && auth.uid === $uid && root.child('system').child('bootstrapComplete').val() !== true && !data.exists() && (newData.child('role').val() === 'IT' || newData.child('role').val() === 'HR'))"
      }
    },
    "appData": {
      ".read": "auth != null && root.child('accounts').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('accounts').child(auth.uid).child('active').val() === true"
    },
    ".read": false,
    ".write": false,
    "pushRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
